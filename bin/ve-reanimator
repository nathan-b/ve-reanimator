#!/usr/bin/env ruby
# Keeps backups of VoidExpanse saves so a death can be undone.
#
# Usage: ve-reanimator [--headless] [Saves directory]
#
# Opens the window by default; --headless just watches and archives, reporting
# on the terminal. Settings come from ve-reanimator.yaml (current directory, or
# ~/.config/ve-reanimator). The saves directory is, in order of preference: the
# command-line argument, saves_dir from the config, or autodiscovery.

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)
require 'reanimator/app'

headless = !ARGV.delete('--headless').nil?
saves_dir = ARGV.shift

begin
  config = Reanimator::Config.load
rescue Reanimator::Config::Error => e
  if headless
    warn "ve-reanimator: #{e.message}"
  else
    require 'reanimator/gui'
    Reanimator::GUI.report_error(e.message)
  end
  exit 1
end

if headless
  begin
    app = Reanimator::App.build(config, saves_dir: saves_dir)
  rescue Reanimator::App::NoSavesDirectory => e
    warn "ve-reanimator: #{e.message}"
    exit 1
  end

  app.start
  puts "Config:     #{config.source || '(none found, using defaults)'}"
  puts "Watching:   #{app.saves_dir}"
  puts "Archiving:  #{config.archive_dir} (keeping #{config.max_saves})"
  puts "Death saves: #{config.death_dir} (keeping #{config.max_death_saves})"

  queue = Queue.new
  %w[INT TERM].each { |sig| trap(sig) { queue << sig } }
  queue.pop
  app.stop
else
  require 'reanimator/gui'
  Reanimator::GUI.run(config, saves_dir: saves_dir)
end
